DATABASE_URL=postgresql://siteforge:siteforge_local@localhost:5439/siteforge
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_CLIENT_EMAIL=cliente@example.test
SEED_CLIENT_PASSWORD=ChangeMe123!
# Storage local for MVP. Mount persistent volume in deployments.
UPLOAD_DIR=./uploads
# PUBLIC_APP_URL must be your verified HTTPS URL in production for invite links
PUBLIC_APP_URL=http://localhost:5173
# For single-origin deployments set this to same URL as PUBLIC_APP_URL
# Never use default SESSION_SECRET or demo credentials in production

# Opcional: IA real. No coloques la clave en src/ ni en VITE_*.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
